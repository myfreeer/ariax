+	void torrent::ariax_checkpoint(std::function<void(error_code, add_torrent_params)> completion)
+	{
+		TORRENT_ASSERT(is_single_thread());
+		// The callback owns its result slot and must never throw. Pausing first
+		// prevents new disk jobs from passing the release fence.
+		pause();
+		auto finish = [self = shared_from_this(), completion = std::move(completion)]() mutable
+		{
+			error_code ec;
+			add_torrent_params result;
+			try
+			{
+				if (self->m_abort) ec = errors::torrent_removed;
+				else if (self->has_error()) ec = self->error();
+				else self->write_resume_data(torrent_handle::save_info_dict, result);
+			}
+			catch (...) { ec = errors::no_memory; }
+			completion(ec, std::move(result));
+		};
+		if (m_storage)
+		{
+			m_ses.disk_thread().async_release_files(m_storage, std::move(finish));
+			m_ses.deferred_submit_jobs();
+		}
+		else finish();
