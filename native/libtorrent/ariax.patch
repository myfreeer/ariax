+		m_add_torrent_params->flags &= ~torrent_flags::default_dont_download;
+		m_ariax_metadata_hold = false;
+		init();
+		set_need_save_resume(torrent_handle::if_metadata_changed);
+		return m_torrent_initialized && !has_error();
