+	// Ariax: install the same protected DACL as the admission layer at creation.
+	// Passing these attributes when opening an existing object leaves its ACL alone.
+	struct ariax_private_security
+	{
+		explicit ariax_private_security(bool const directory)
+		{
+			HANDLE token = nullptr;
+			if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token))
+			{ error = GetLastError(); return; }
+			std::array<std::uintptr_t, 128> buffer{};
+			DWORD size = sizeof(buffer);
+			BOOL const loaded = GetTokenInformation(token, TokenUser, buffer.data(), size, &size);
+			DWORD const token_error = GetLastError();
+			CloseHandle(token);
+			if (!loaded) { error = token_error; return; }
+			auto const user = reinterpret_cast<TOKEN_USER const*>(buffer.data());
+			LPWSTR sid = nullptr;
+			if (!ConvertSidToStringSidW(user->User.Sid, &sid))
+			{ error = GetLastError(); return; }
+			auto const release = [](wchar_t* p) { LocalFree(p); };
+			std::unique_ptr<wchar_t, decltype(release)> owned_sid(sid, release);
+			std::wstring const flags = directory ? L"OICI" : L"";
+			std::wstring const sddl = std::wstring(L"O:") + sid + L"D:P(A;" + flags
+				+ L";FA;;;" + sid + L")(A;" + flags + L";FA;;;SY)(A;" + flags + L";FA;;;BA)";
+			if (!ConvertStringSecurityDescriptorToSecurityDescriptorW(sddl.c_str(), SDDL_REVISION_1,
+				&attributes.lpSecurityDescriptor, nullptr))
+			{ error = GetLastError(); return; }
+		}
+		~ariax_private_security()
+		{
+			DWORD const saved = GetLastError();
+			LocalFree(attributes.lpSecurityDescriptor);
+			SetLastError(saved);
+		}
+		ariax_private_security(ariax_private_security const&) = delete;
+		ariax_private_security& operator=(ariax_private_security const&) = delete;
+		bool valid() const
+		{
+			if (attributes.lpSecurityDescriptor != nullptr) return true;
+			SetLastError(error);
+			return false;
+		}
+		SECURITY_ATTRIBUTES attributes{sizeof(SECURITY_ATTRIBUTES), nullptr, FALSE};
+		DWORD error = ERROR_ACCESS_DENIED;
+	};
 
