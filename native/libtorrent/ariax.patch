+#ifdef TORRENT_WINDOWS
+// Ariax: transfer the private kernel handle into stdio without reopening it.
+inline FILE* ariax_create_file(wchar_t const* const path)
+{
+	ariax_private_security security(false);
+	if (!security.valid()) { errno = EACCES; return nullptr; }
+	HANDLE const handle = CreateFileW(path, GENERIC_READ | GENERIC_WRITE,
+		FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, &security.attributes,
+		CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+	if (handle == INVALID_HANDLE_VALUE)
+	{
+		DWORD const error = GetLastError();
+		errno = error == ERROR_FILE_NOT_FOUND || error == ERROR_PATH_NOT_FOUND ? ENOENT
+			: error == ERROR_ACCESS_DENIED ? EACCES : EIO;
+		return nullptr;
+	}
+	int const fd = ::_open_osfhandle(reinterpret_cast<std::intptr_t>(handle), _O_RDWR | _O_BINARY);
+	if (fd < 0)
+	{
+		int const error = errno;
+		CloseHandle(handle);
+		errno = error;
+		return nullptr;
+	}
+	FILE* const file = ::_fdopen(fd, "wb+");
+	if (file == nullptr)
+	{
+		int const error = errno;
+		::_close(fd);
+		errno = error;
+	}
+	return file;
+}
+#else
+// Ariax: stdio storage must use the same private creation modes as file_handle.
+inline FILE* ariax_create_file(char const* const path, bool const executable = false)
+{
+	int flags = O_RDWR | O_CREAT | O_TRUNC;
+#ifdef O_CLOEXEC
+	flags |= O_CLOEXEC;
+#endif
+	int const fd = ::open(path, flags, S_IRUSR | S_IWUSR | (executable ? S_IXUSR : 0));
+	if (fd < 0) return nullptr;
+	FILE* const file = ::fdopen(fd, "wb+");
+	if (file == nullptr)
+	{
+		int const error = errno;
+		::close(fd);
+		errno = error;
+	}
+	return file;
+}
+#endif
