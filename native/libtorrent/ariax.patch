+	bool ariax_redirect_allowed(std::string const& source, std::string const& target)
+	{
+		if (target.size() > 4096 || target.find('#') != std::string::npos
+			|| std::any_of(target.begin(), target.end(), [](unsigned char c)
+				{ return c <= 0x20 || c == 0x7f || c == '\\'; })) return false;
+		error_code ec;
+		auto const [scheme, auth, host, port, path] = parse_url_components(target, ec);
+		if (ec || !auth.empty() || host.empty() || port == 0 || port > 65535
+			|| (scheme != "http" && scheme != "https")
+			|| (source.compare(0, 8, "https://") == 0 && scheme != "https")) return false;
+		auto const question = target.find('?');
+		if (question == std::string::npos) return true;
+		auto const original_question = source.find('?');
+		std::string const original = original_question == std::string::npos
+			? std::string() : "&" + source.substr(original_question + 1) + "&";
+		auto hex = [](char c) -> int {
+			if (c >= '0' && c <= '9') return c - '0';
+			if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+			if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+			return -1;
+		};
+		for (auto start = question + 1; start < target.size(); )
+		{
+			auto const end = target.find('&', start);
+			auto const field = target.substr(start, end - start);
+			auto const equals = field.find('=');
+			auto const encoded = field.substr(0, equals);
+			std::string key;
+			for (std::size_t i = 0; i < encoded.size(); ++i)
+			{
+				unsigned char c = static_cast<unsigned char>(encoded[i]);
+				if (c == '%')
+				{
+					if (i + 2 >= encoded.size() || hex(encoded[i + 1]) < 0 || hex(encoded[i + 2]) < 0) return false;
+					c = static_cast<unsigned char>(hex(encoded[i + 1]) * 16 + hex(encoded[i + 2]));
+					i += 2;
+				}
+				if (c >= 'A' && c <= 'Z') c = static_cast<unsigned char>(c - 'A' + 'a');
+				key.push_back(static_cast<char>(c));
+			}
+			bool const protocol_key = key == "key" && original.find("&" + field + "&") != std::string::npos;
+			if (!protocol_key && (key == "token" || key == "key" || key == "passkey"
+				|| key == "auth" || key == "password" || key == "secret"
+				|| key == "signature" || key == "access_token")) return false;
+			if (end == std::string::npos) break;
+			start = end + 1;
+		}
+		return true;
+	}
+
 }
