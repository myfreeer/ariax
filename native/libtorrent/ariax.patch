+	bool torrent::ariax_approve_metadata(std::vector<std::string> const& paths
+		, std::vector<download_priority_t> const& priorities)
+	{
+		TORRENT_ASSERT(is_single_thread());
+		if (!ariax_metadata_held() || m_abort || m_torrent_initialized || !m_add_torrent_params
+			|| paths.size() != std::size_t(m_torrent_file->num_files())
+			|| priorities.size() != paths.size()) return false;
+		// Validate the complete mapping before mutating any initialization state.
+		for (auto const& path : paths)
+		{
+			if (path.empty() || path.front() == '/' || path.front() == '\\'
+				|| path.find(':') != std::string::npos || path.find('\0') != std::string::npos)
+				return false;
+			std::size_t start = 0;
+			while (start < path.size())
+			{
+				auto const end = path.find_first_of("/\\", start);
+				auto const part = path.substr(start, end - start);
+				if (part.empty() || part == "." || part == "..") return false;
+				if (end == std::string::npos) break;
+				start = end + 1;
+			}
+		}
+		for (std::size_t i = 0; i < paths.size(); ++i)
+			m_add_torrent_params->renamed_files[file_index_t(int(i))] = paths[i];
+		m_file_priority.assign(priorities.begin(), priorities.end());
+		m_add_torrent_params->file_priorities = priorities;
+		m_add_torrent_params->flags &= ~torrent_flags::default_dont_download;
+		m_ariax_metadata_hold = false;
+		init();
+		set_need_save_resume(torrent_handle::if_metadata_changed);
+		return m_torrent_initialized && !has_error();
+	}
