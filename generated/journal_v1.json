{
  "schema": 1,
  "format": {"version": 1, "byte_order": "little_endian", "endianness_assertion": 1, "sequence_origin": 1},
  "segment_header": {"magic": "ARXJ", "length": 104, "flags": 0, "crc": {"algorithm": "crc-32c-castagnoli", "coverage_bytes": 100}},
  "record": {"magic": "ARXR", "prefix_length": 28, "fixed_overhead": 36, "max_payload_bytes": 16777216, "flags": 0, "crc": {"algorithm": "crc-32c-castagnoli", "coverage": "record_magic_through_payload"}, "commit": "CMIT", "commit_written_after_crc": true},
  "segment_hash": {"algorithm": "sha-256", "domain_hex": "61726961782f7365676d656e742f763100", "coverage": ["domain", "encoded_length_le_u64", "valid_segment_bytes"]},
  "record_types": [
    {"number": 1, "code": "task_created"},
    {"number": 2, "code": "options_snapshot"},
    {"number": 3, "code": "layout_committed"},
    {"number": 4, "code": "generation_started"},
    {"number": 5, "code": "lease_started"},
    {"number": 6, "code": "piece_started"},
    {"number": 7, "code": "piece_written"},
    {"number": 8, "code": "lease_committed"},
    {"number": 9, "code": "lease_aborted"},
    {"number": 10, "code": "piece_verified"},
    {"number": 11, "code": "piece_failed"},
    {"number": 12, "code": "piece_durable"},
    {"number": 13, "code": "retry_state"},
    {"number": 14, "code": "task_paused"},
    {"number": 15, "code": "task_complete"},
    {"number": 16, "code": "task_error"},
    {"number": 17, "code": "task_removed"},
    {"number": 18, "code": "clean_shutdown"},
    {"number": 19, "code": "checkpoint_start"},
    {"number": 20, "code": "checkpoint_end"},
    {"number": 21, "code": "layout_chunk"},
    {"number": 22, "code": "finalize_intent"},
    {"number": 23, "code": "finalize_done"},
    {"number": 24, "code": "piece_state_chunk"}
  ],
  "header_rejections": ["truncated", "invalid_magic", "bad_crc", "unsupported_version", "invalid_endianness", "unknown_flags", "zero_gid", "zero_journal_id", "invalid_first_sequence", "unexpected_previous_link", "missing_previous_link"],
  "record_stop_reasons": ["truncated_framing", "invalid_magic", "payload_too_large", "unknown_record_type", "unknown_flags", "sequence_gap", "generation_before_segment", "length_overflow", "truncated_record", "bad_crc", "missing_commit"],
  "replay_limits": {"segments": 1024, "records": 262144, "payload_bytes": 67108864},
  "replay_resources": ["segments", "records", "payload_bytes"],
  "replay_contract": {"caller_orders_by_segment_index": true, "validates_task_and_journal_identity": true, "validates_previous_segment_hash": true, "global_sequence_contiguous": true, "stop_at_first_invalid_byte": true, "valid_prefix_authoritative": true, "newer_segments_after_failure_ignored": true}
}
