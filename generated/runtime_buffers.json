{
  "schema": 1,
  "size_classes": [
    {"code": "16_kib", "capacity": 16384},
    {"code": "64_kib", "capacity": 65536},
    {"code": "256_kib", "capacity": 262144},
    {"code": "1_mib", "capacity": 1048576}
  ],
  "owners": ["pool", "network", "transform", "storage", "disk", "cpu", "journal", "quarantine"],
  "buffer_states": [
    {"code": "free", "mutable": false, "readable": false, "transitions_to": []},
    {"code": "reserved", "mutable": true, "readable": false, "transitions_to": ["network_fill", "transform_owned", "releasable"]},
    {"code": "network_fill", "mutable": true, "readable": false, "transitions_to": ["transform_owned", "filled", "releasable"]},
    {"code": "transform_owned", "mutable": true, "readable": false, "transitions_to": ["filled", "releasable"]},
    {"code": "filled", "mutable": false, "readable": true, "transitions_to": ["validating", "disk_queued", "hash_borrowed", "journal_pending", "releasable"]},
    {"code": "validating", "mutable": false, "readable": true, "transitions_to": ["disk_queued", "hash_borrowed", "journal_pending", "releasable"]},
    {"code": "disk_queued", "mutable": false, "readable": true, "transitions_to": ["disk_in_flight", "releasable"]},
    {"code": "disk_in_flight", "mutable": false, "readable": true, "transitions_to": ["disk_done"]},
    {"code": "disk_done", "mutable": false, "readable": true, "transitions_to": ["hash_borrowed", "journal_pending", "releasable"]},
    {"code": "hash_borrowed", "mutable": false, "readable": true, "transitions_to": ["disk_queued", "disk_done", "journal_pending", "releasable"]},
    {"code": "journal_pending", "mutable": false, "readable": true, "transitions_to": ["releasable"]},
    {"code": "releasable", "mutable": false, "readable": true, "transitions_to": []}
  ],
  "stats_sampler": {
    "profiles": [
      {"code": "concurrency", "interval_ms": 1000},
      {"code": "throughput", "interval_ms": 500},
      {"code": "latency", "interval_ms": 250},
      {"code": "compact", "interval_ms": 1000}
    ],
    "conditions": ["none", "idle", "stalled", "backpressured", "rate_limited"],
    "reasons": ["connect_timeout", "handshake_timeout", "first_byte_timeout", "between_bytes_timeout", "lowest_speed", "disk_write_timeout", "disk_backpressure", "buffer_backpressure", "cpu_backpressure", "journal_backpressure", "ingress_rate_limit"],
    "minimum_override_ms": 100,
    "maximum_override_ms": 10000,
    "maximum_active_entries": 100000,
    "packet_independent": true,
    "zero_delta_samples_zero": true,
    "integer_ewma_previous_weight": 3,
    "integer_ewma_instant_weight": 1,
    "sample_age_is_query_derived": true
  },
  "budget_contract": {"domain_and_resident_permits_required": true, "zero_byte_reservation_allowed": false},
  "pool_contract": {"free_list": "lifo_per_size_class", "stable_capacity": true, "drop_destination": "quarantine", "quarantine_exhaustion": "fault_backend", "timeout_reclamation": "retire_without_releasing_pool_budget"},
  "queue_contract": {"item_bounded": true, "byte_bounded": true, "credit_before_read": true, "close_returns_queued_ownership": true},
  "completion_contract": {"reserve_before_backend_acceptance": true, "send_after_admission_close": true, "capacity_failure_after_acceptance": false}
}
