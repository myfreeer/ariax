+        drop(rd);
+        rc.cancel();
+        handler.closed(failure).await;
+    });
+    runtime::spawn(async move {
+        let _drain = write_guard;
+        loop {
+            let data = select! {
+                biased;
+                _ = cancel.cancelled() => break,
+                data = rx.recv() => match data { Some(data) => data, None => break },
