+macro_rules! impl_try_into_bytes {
+    ($struct:ty) => {
+        impl TryInto<Vec<u8>> for $struct {
+            type Error = Error;
+
+            fn try_into(self) -> Result<Vec<u8>, Self::Error> {
+                ser::to_bytes(&self).map(|b| b.to_vec())
+            }
+        }
+    };
