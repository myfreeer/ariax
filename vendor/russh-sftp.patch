+                biased;
+                _ = cancel.cancelled() => break,
+                result = wr.write_all(&data) => result,
+            };
+            if result.is_err() { break; }
+        }
+        rx.close();
+        drop(rx);
+        cancel.cancel();
+        drop(wr);
+    });
+    (tx,receiver)
